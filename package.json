{
  "name": "so-i-quit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:generate": "nuxt generate",
    "mobile:sync": "npm run mobile:generate && cap sync",
    "mobile:run": "cap run android",
    "mobile:run:ios": "cap run ios",
