    "mobile:apk:release": "cd android && ./gradlew assembleRelease",
    "mobile:dev": "npm run dev -- --host 0.0.0.0",
    "mobile:run:live": "node scripts/live-reload.mjs",
    "mobile:icons": "bash scripts/generate-icons.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
