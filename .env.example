# So I Quit — environment variables (all optional)
#
# Copy to `.env` (gitignored) when you need any of these locally.
# Nuxt 4 loads .env automatically; NUXT_PUBLIC_* values are embedded at
# build time, so changes require a rebuild (`npm run generate`).

# Sentry error tracking (opt-in). Leave empty to disable — the app is
# local-only and the plugin is a complete no-op without this.
# Feeds runtimeConfig.public.sentryDsn (app/plugins/sentry.client.ts).
# Get a DSN at https://sentry.io (or your self-hosted instance).
NUXT_PUBLIC_SENTRY_DSN=

# Dev-only Capacitor live reload. `npm run mobile:run:live`
# (scripts/live-reload.mjs) computes the LAN URL and injects this
# automatically — only set it manually to point the dev app at a
# specific server. Never commit a real URL here.
# CAP_LIVE_URL=http://<LAN-IP>:3000
