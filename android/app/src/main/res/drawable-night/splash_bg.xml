<?xml version="1.0" encoding="utf-8"?>
<!--
  Night variant of @drawable/splash_bg — the deeper teal of
  assets/splash-dark.svg (#15594e → #0f463f → #072622). Resolved
  automatically by the night qualifier (the launch window background of both
  activities reads @drawable/splash_bg).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#0F463F"
        android:endColor="#072622"
        android:startColor="#15594E"
        android:type="linear" />
</shape>
