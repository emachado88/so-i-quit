<?xml version="1.0" encoding="utf-8"?>
<!--
  Full launch art: the brand gradient (@drawable/splash_bg, night-aware) with
  the pulse logo centred.

  This is the launch window background of BOTH activities (ANDROID:windowBackground
  in AppTheme.NoActionBarLaunch). The window background is painted by the system
  from the very first frame of the process — before any of our Java runs — so
  the logo is on screen from the instant the app opens, with no gap where only
  the gradient is up (the previous design put the logo in a view that could
  only draw once Capacitor had built the WebView, which is what made it appear
  late). SplashActivity hands off to MainActivity whose window background is
  this same art, so the logo never blinks across the hand-off and the WebView
  simply takes over whenever it is ready.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_bg" />

    <item
        android:drawable="@drawable/splash_logo"
        android:gravity="center"
        android:height="@dimen/splash_logo_size"
        android:width="@dimen/splash_logo_size" />
</layer-list>
